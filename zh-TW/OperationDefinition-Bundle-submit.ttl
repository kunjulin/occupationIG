     fhir:OperationDefinition.parameter.documentation [ fhir:value "成功時為 type = transaction-response 之 Bundle，逐 entry 回報 response.status 與伺服器指派之位址；驗證失敗時整體回應為 OperationOutcome（HTTP 422），issue.expression 指向出錯之 entry 路徑。" ] ;
     fhir:OperationDefinition.parameter.type [ fhir:value "Bundle" ]
  ] .


     fhir:OperationDefinition.parameter.min [ fhir:value "1"^^xsd:integer ] ;
     fhir:OperationDefinition.parameter.max [ fhir:value "1" ] ;
     fhir:OperationDefinition.parameter.documentation [ fhir:value "上傳封包，須符合 TWHA-Bundle-Transaction（每個 entry 具 request.method 與 request.url）。範例見 Bundle-UC-008.html／Bundle-UC-009.html。" ] ;
     fhir:OperationDefinition.parameter.type [ fhir:value "Bundle" ] ;

  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "duration-years" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "嚼食持續期間" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "嚼食檳榔之持續期間（嚼了多久），以 UCUM `a` 或 `mo` 表達，**以原始採集粒度為準**（不得將「嚼 2 年」逕行改寫為 24 個月）。承載主管機關最小上傳集第 11 列（醫令 30907X-3「嚼檳月數」，經主管機關答覆確認其語意為嚼食持續期間而非戒檳月數）。對應上游 sf-BetNutChewBeh#year。⚠️ 代碼 id 保留 `duration-years` 係因該碼已於 v0.4.0 發佈，改名屬破壞性變更；真實語意以本顯示名與定義為準。" ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "cessation-duration" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "戒除期間" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "已戒除之期間，以 UCUM `a` 或 `mo` 表達，**以原始採集粒度為準**（不得將「已戒 1 年」逕行改寫為 12 個月）。對應上游 sf-BetNutChewBeh#quit。" ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "cessation-date" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "戒除日期" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "戒除之日期（得僅至年或年月）。**日期為原始事實，期間為導出值**——期間會隨檢查日改變，故兩者並存時以本欄為準。**不得由「已戒 N 年」回推本欄**。" ]
  ], [

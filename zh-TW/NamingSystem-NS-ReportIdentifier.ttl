       fhir:ContactPoint.system [ fhir:value "url" ] ;
       fhir:ContactPoint.value [ fhir:value "https://twcore.mohw.gov.tw/twregistry/" ]
     ]
  ], [
     fhir:index -1 ;
     fhir:ContactDetail.name [ fhir:value "衛生福利部次世代數位醫療平臺專案辦公室" ] ;
     fhir:ContactDetail.telecom [
       fhir:index -1 ;
       fhir:ContactPoint.system [ fhir:value "url" ] ;
       fhir:ContactPoint.value [ fhir:value "https://twcore.mohw.gov.tw/twregistry/" ]
     ]
  ] ;
  fhir:NamingSystem.responsible [ fhir:value "產生封包之健檢機構（本 IG 僅規範命名空間，不集中發放）"] ;
  fhir:NamingSystem.description [ fhir:value "勞工健康檢查報告封包（Bundle）之識別碼命名空間。\n\n**唯一性要求**：值在同一健檢機構內須唯一且不重複使用；跨機構之唯一性由\n「命名空間 + 值」的組合達成。上傳端據此判定是否為同一份封包之重送（去重）。\n\n**穩定性要求**：同一份健檢報告重新上傳（例如更正後重送）時**應沿用相同的識別碼**，\n否則監理端無從判斷這是更正還是新的一筆。若確為另一次健檢，則須給新的識別碼。\n\n**不得**以流水號以外可回推受檢者身分之內容組成（例如身分證號、病歷號）。"] ;

  fhir:NamingSystem.kind [ fhir:value "identifier"] ;
  fhir:NamingSystem.date [ fhir:value "2026-07-27"^^xsd:date] ;
  fhir:NamingSystem.publisher [ fhir:value "衛生福利部次世代數位醫療平臺專案辦公室 & 長庚醫療財團法人長庚紀念醫院"] ;
  fhir:NamingSystem.contact [
     fhir:index -1 ;
     fhir:ContactDetail.name [ fhir:value "衛生福利部次世代數位醫療平臺專案辦公室 & 長庚醫療財團法人長庚紀念醫院" ] ;
     fhir:ContactDetail.telecom [

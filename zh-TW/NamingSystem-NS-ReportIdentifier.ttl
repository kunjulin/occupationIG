     fhir:NamingSystem.uniqueId.preferred [ fhir:value "true"^^xsd:boolean ] ;
     fhir:NamingSystem.uniqueId.comment [ fhir:value "canonical namespace 為 provisional，正式核定後須更新（CLAUDE.md §6）。" ]
  ] .


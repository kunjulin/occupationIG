<https://twcore.mohw.gov.tw/ig/twha/NamingSystem/NS-ReportIdentifier> a fhir:NamingSystem ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "NS-ReportIdentifier"] ;
  fhir:Resource.language [ fhir:value "zh-TW"] ;
  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "generated" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: 命名系统 NS-ReportIdentifier</b></p><a name=\"NS-ReportIdentifier\"> </a><a name=\"hcNS-ReportIdentifier\"> </a><h3>Summary</h3><table class=\"grid\"><tr><td>Defining URL</td><td>https://twcore.mohw.gov.tw/ig/twha/NamingSystem/NS-ReportIdentifier</td></tr><tr><td>Version</td><td>0.4.0</td></tr><tr><td>Name</td><td>TWHAReportIdentifier</td></tr><tr><td>Status</td><td>draft</td></tr><tr><td>Definition</td><td><div><p>勞工健康檢查報告封包（Bundle）之識別碼命名空間。</p>\n<p><strong>唯一性要求</strong>：值在同一健檢機構內須唯一且不重複使用；跨機構之唯一性由\n「命名空間 + 值」的組合達成。上傳端據此判定是否為同一份封包之重送（去重）。</p>\n<p><strong>穩定性要求</strong>：同一份健檢報告重新上傳（例如更正後重送）時<strong>應沿用相同的識別碼</strong>，\n否則監理端無從判斷這是更正還是新的一筆。若確為另一次健檢，則須給新的識別碼。</p>\n<p><strong>不得</strong>以流水號以外可回推受檢者身分之內容組成（例如身分證號、病歷號）。</p>\n</div></td></tr><tr><td>Publisher</td><td>衛生福利部次世代數位醫療平臺專案辦公室 &amp; 長庚醫療財團法人長庚紀念醫院</td></tr></table><h3>Identifiers</h3><table class=\"grid\"><tr><td><b>Type</b></td><td><b>Value</b></td><td><b>Preferred</b></td><td><b>Comment</b></td></tr><tr><td>URI</td><td>https://twcore.mohw.gov.tw/ig/twha/sid/report-id</td><td>true</td><td>canonical namespace 為 provisional，正式核定後須更新（CLAUDE.md §6）。</td></tr></table></div>"
  ] ;
  fhir:DomainResource.extension [
     fhir:index -1 ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-NamingSystem.url" ] ;
     fhir:Extension.valueUri [ fhir:value "https://twcore.mohw.gov.tw/ig/twha/NamingSystem/NS-ReportIdentifier" ]
  ], [

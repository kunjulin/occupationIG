         fhir:Coding.system [ fhir:value "https://twcore.mohw.gov.tw/ig/twha/CodeSystem/CS-FitnessForWork" ] ;
         fhir:Coding.code [ fhir:value "reduce-hours" ] ;
         fhir:Coding.display [ fhir:value "縮短工作時間" ]
       ]
     ]
  ] ;
  fhir:CarePlan.status [ fhir:value "active"] ;

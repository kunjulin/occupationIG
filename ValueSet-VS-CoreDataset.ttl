  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "generated" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: 取值集合 VS-CoreDataset</b></p><a name=\"VS-CoreDataset\"> </a><a name=\"hcVS-CoreDataset\"> </a><ul><li>Include these codes as defined in <a href=\"http://loinc.org\"><code>http://loinc.org</code></a><span title=\"Version is not explicitly stated. No matching Code System found\"> version Not Stated (use latest from terminology server)</span><table class=\"none\"><tr><td style=\"white-space:nowrap\"><b>Code</b></td><td><b>Display</b></td><td><b><a href=\"ValueSet-VS-CoreDataset.html\">健康檢查檢驗項目代碼對應 ConceptMap</a></b></td></tr><tr><td><a href=\"https://loinc.org/2093-3/\">2093-3</a></td><td>Cholesterol [Mass/volume] in Serum or Plasma</td><td/></tr><tr><td><a href=\"https://loinc.org/35200-5/\">35200-5</a></td><td>Cholesterol [Mass or Moles/volume] in Serum or Plasma</td><td><span title=\"SOURCEISBROADERTHANTARGET\">&gt;</span><a href=\"https://loinc.org/2093-3/\">2093-3</a><i>(source 允許質量或莫耳濃度兩種尺度，語意較 target 廣)</i></td></tr><tr><td><a href=\"https://loinc.org/1558-6/\">1558-6</a></td><td>Fasting glucose [Mass/volume] in Serum or Plasma</td><td/></tr><tr><td><a href=\"https://loinc.org/2339-0/\">2339-0</a></td><td>Glucose [Mass/volume] in Blood</td><td><span title=\"RELATEDTO\">?</span><a href=\"https://loinc.org/1558-6/\">1558-6</a><i>(空腹狀態與檢體均不同（source 為未指定空腹之全血、target 為空腹血漿），無包含關係；全血與血漿葡萄糖數值不可直接比較（比照 element[5] 之處理）)</i></td></tr><tr><td><a href=\"https://loinc.org/2345-7/\">2345-7</a></td><td>Glucose [Mass/volume] in Serum or Plasma</td><td><span title=\"SOURCEISBROADERTHANTARGET\">&gt;</span><a href=\"https://loinc.org/1558-6/\">1558-6</a><i>(source 為未指定空腹狀態之一般血糖，語意較 target(空腹)廣)</i></td></tr><tr><td><a href=\"https://loinc.org/2571-8/\">2571-8</a></td><td>Triglyceride [Mass/volume] in Serum or Plasma</td><td/></tr><tr><td><a href=\"https://loinc.org/3043-7/\">3043-7</a></td><td>Triglyceride [Mass/volume] in Blood</td><td><span title=\"RELATEDTO\">?</span><a href=\"https://loinc.org/2571-8/\">2571-8</a><i>(檢體不同(Blood vs Serum/Plasma))</i></td></tr><tr><td><a href=\"https://loinc.org/2085-9/\">2085-9</a></td><td>Cholesterol in HDL [Mass/volume] in Serum or Plasma</td><td/></tr><tr><td><a href=\"https://loinc.org/2089-1/\">2089-1</a></td><td>Cholesterol in LDL [Mass/volume] in Serum or Plasma</td><td/></tr><tr><td><a href=\"https://loinc.org/13457-7/\">13457-7</a></td><td>Cholesterol in LDL [Mass/volume] in Serum or Plasma by calculation</td><td><span title=\"SOURCEISNARROWERTHANTARGET\">&lt;</span><a href=\"https://loinc.org/2089-1/\">2089-1</a><i>(source 指定計算法，target 方法未指定)</i></td></tr><tr><td><a href=\"https://loinc.org/18262-6/\">18262-6</a></td><td>Cholesterol in LDL [Mass/volume] in Serum or Plasma by Direct assay</td><td><span title=\"SOURCEISNARROWERTHANTARGET\">&lt;</span><a href=\"https://loinc.org/2089-1/\">2089-1</a><i>(source 指定 Direct assay，target 方法未指定)</i></td></tr><tr><td><a href=\"https://loinc.org/2160-0/\">2160-0</a></td><td>Creatinine [Mass/volume] in Serum or Plasma</td><td/></tr><tr><td><a href=\"https://loinc.org/38483-4/\">38483-4</a></td><td>Creatinine [Mass/volume] in Blood</td><td><span title=\"RELATEDTO\">?</span><a href=\"https://loinc.org/2160-0/\">2160-0</a><i>(檢體不同(Blood vs Serum/Plasma)，非包含關係)</i></td></tr><tr><td><a href=\"https://loinc.org/2888-6/\">2888-6</a></td><td>Protein [Mass/volume] in Urine</td><td/></tr><tr><td><a href=\"https://loinc.org/5804-0/\">5804-0</a></td><td>Protein [Mass/volume] in Urine by Test strip</td><td/></tr><tr><td><a href=\"https://loinc.org/57735-3/\">57735-3</a></td><td>Protein [Presence] in Urine by Automated test strip</td><td><span title=\"SOURCEISNARROWERTHANTARGET\">&lt;</span><a href=\"https://loinc.org/5804-0/\">5804-0</a><i>(source 指定自動化試紙判讀，target 方法未指定自動化；target 語意較廣)</i></td></tr><tr><td><a href=\"https://loinc.org/5196-1/\">5196-1</a></td><td>Hepatitis B virus surface Ag [Presence] in Serum or Plasma by Immunoassay</td><td/></tr><tr><td><a href=\"https://loinc.org/5195-3/\">5195-3</a></td><td>Hepatitis B virus surface Ag [Presence] in Serum</td><td><span title=\"RELATEDTO\">?</span><a href=\"https://loinc.org/5196-1/\">5196-1</a><i>(source 限 Serum、target 為 Serum or Plasma 且指定 Immunoassay，兩者互有寬窄)</i></td></tr><tr><td><a href=\"https://loinc.org/63557-3/\">63557-3</a></td><td>Hepatitis B virus surface Ag [Units/volume] in Serum or Plasma by Immunoassay</td><td><span title=\"RELATEDTO\">?</span><a href=\"https://loinc.org/5196-1/\">5196-1</a><i>(source 為定量（Units/volume）、target 為定性（Presence），Property 不同而無包含關係；定量值不可直接當作定性結果比較，須依判讀閾值轉換)</i></td></tr><tr><td><a href=\"https://loinc.org/13955-0/\">13955-0</a></td><td>Hepatitis C virus Ab [Presence] in Serum or Plasma by Immunoassay</td><td/></tr><tr><td><a href=\"https://loinc.org/16128-1/\">16128-1</a></td><td>Hepatitis C virus Ab [Presence] in Serum</td><td><span title=\"RELATEDTO\">?</span><a href=\"https://loinc.org/13955-0/\">13955-0</a><i>(source 限 Serum、target 為 Serum or Plasma 且指定 Immunoassay，兩者互有寬窄)</i></td></tr></table></li></ul></div>"

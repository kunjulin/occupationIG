       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "SDOH 社會決定因素問卷回覆實例" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "王大同的精簡版 PRAPARE 社會風險問卷回覆結果。" ] ;
